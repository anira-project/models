{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ANIRA_MODELS_LINK_COMPILE_COMMANDS": "ON",
        "ANIRA_WITH_ONNXRUNTIME": "ON",
        "ANIRA_WITH_LITERT": "ON",
        "ANIRA_WITH_LIBTORCH": "OFF",
        "ANIRA_WITH_EXECUTORCH": "OFF"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (ONNX Runtime + LiteRT; compile DB for clangd)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/desktop/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release (ONNX Runtime + LiteRT)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/desktop/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "all-backends",
      "displayName": "Release with LibTorch as well",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/desktop/all-backends",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ANIRA_WITH_LIBTORCH": "ON"
      }
    },
    {
      "name": "debug-asan",
      "displayName": "Debug with AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/desktop/debug-asan",
      "cacheVariables": { "ANIRA_MODELS_WITH_ASAN": "ON" }
    },
    {
      "name": "debug-tsan",
      "displayName": "Debug with ThreadSanitizer",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/desktop/debug-tsan",
      "cacheVariables": { "ANIRA_MODELS_WITH_TSAN": "ON" }
    },
    {
      "name": "debug-rtsan",
      "displayName": "Debug with RealtimeSanitizer (clang 20)",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/desktop/debug-rtsan",
      "cacheVariables": { "ANIRA_MODELS_WITH_RTSAN": "ON" }
    },
    {
      "name": "windows-release",
      "displayName": "Release on Windows with MSVC (ONNX Runtime + LiteRT)",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/desktop/windows-release",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "all-backends", "configurePreset": "all-backends" },
    { "name": "debug-asan", "configurePreset": "debug-asan" },
    { "name": "debug-tsan", "configurePreset": "debug-tsan" },
    { "name": "debug-rtsan", "configurePreset": "debug-rtsan" },
    { "name": "windows-release", "configurePreset": "windows-release" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "all-backends", "configurePreset": "all-backends", "output": { "outputOnFailure": true } },
    { "name": "debug-asan", "configurePreset": "debug-asan", "output": { "outputOnFailure": true } },
    { "name": "debug-tsan", "configurePreset": "debug-tsan", "output": { "outputOnFailure": true } },
    { "name": "debug-rtsan", "configurePreset": "debug-rtsan", "output": { "outputOnFailure": true } },
    { "name": "windows-release", "configurePreset": "windows-release", "output": { "outputOnFailure": true } }
  ]
}
