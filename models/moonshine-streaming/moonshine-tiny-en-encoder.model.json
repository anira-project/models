{
  "models": [
    {"engine": "onnxruntime", "path": "tiny-en/encoder.onnx"},
    {"engine": "executorch", "path": "tiny-en/executorch/encoder.pte"},
    {"engine": "executorch", "provider": "coreml", "path": "tiny-en/executorch/encoder_coreml.pte"},
    {"engine": "org.anira-project.models.coreml", "provider": "coreml", "path": "tiny-en/coreml/encoder.mlpackage"}
  ],
  "state": "stateful",
  "inputs": [
    {"name": "audio", "dtype": "float32", "role": "buffer", "axes": [["batch", 1], ["any", 8000]]},
    {"name": "conv1_buffer", "dtype": "float32", "role": "state", "axes": [["batch", 1], ["feature", 320], ["any", 4]], "state_source": "conv1_buffer_out"},
    {"name": "conv2_buffer", "dtype": "float32", "role": "state", "axes": [["batch", 1], ["feature", 640], ["any", 4]], "state_source": "conv2_buffer_out"},
    {"name": "features", "dtype": "float32", "role": "state", "axes": [["batch", 1], ["any", 112], ["feature", 320]], "state_source": "features_out"},
    {"name": "position", "dtype": "int32", "role": "static", "axes": [["any", 1]]},
    {"name": "length", "dtype": "int32", "role": "static", "axes": [["any", 1]]}
  ],
  "outputs": [
    {"name": "k_cross", "dtype": "float32", "role": "buffer", "axes": [["any", 6], ["batch", 1], ["any", 8], ["any", 25], ["feature", 40]]},
    {"name": "v_cross", "dtype": "float32", "role": "buffer", "axes": [["any", 6], ["batch", 1], ["any", 8], ["any", 25], ["feature", 40]]},
    {"name": "conv1_buffer_out", "dtype": "float32", "role": "state", "axes": [["batch", 1], ["feature", 320], ["any", 4]]},
    {"name": "conv2_buffer_out", "dtype": "float32", "role": "state", "axes": [["batch", 1], ["feature", 640], ["any", 4]]},
    {"name": "features_out", "dtype": "float32", "role": "state", "axes": [["batch", 1], ["any", 112], ["feature", 320]]}
  ]
}
