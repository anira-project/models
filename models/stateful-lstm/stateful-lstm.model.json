{
  "models": [
    {"engine": "onnxruntime", "path": "onnx/stateful_lstm.onnx"},
    {"engine": "litert", "path": "litert/stateful_lstm.tflite"},
    {"engine": "tflite", "path": "litert/stateful_lstm.tflite"},
    {"engine": "executorch", "path": "executorch/stateful_lstm.pte"},
    {"engine": "executorch", "provider": "coreml", "path": "executorch/stateful_lstm_coreml.pte"},
    {"engine": "libtorch", "path": "libtorch/stateful_lstm.pt"},
