{
  "models": [
    {"engine": "libtorch", "path": "libtorch/simple_gain_network_16ch.pt"},
    {"engine": "onnxruntime", "path": "onnx/simple_gain_network_16ch.onnx"},
    {"engine": "tflite", "path": "litert/simple_gain_network_16ch.tflite", "tensors": {"gain": {"layout": [0, "insert", "insert"]}}},
    {"engine": "litert", "path": "litert/simple_gain_network_16ch.tflite", "tensors": {"gain": {"layout": [0, "insert", "insert"]}, "audio_out": {"name": "output_0"}, "gain_out": {"name": "output_1"}}},
    {"engine": "executorch", "path": "executorch/simple_gain_network_16ch.pte"},
    {"engine": "executorch", "provider": "coreml", "path": "executorch/simple_gain_network_16ch_coreml.pte"}
  ],
  "inputs": [
    {
      "name": "audio_in",
      "dtype": "float32",
      "role": "streamed",
      "axes": [["batch", 1], ["channel", 16], ["time", 512]],
      "window": { "min": 512, "max": 512 }
    },
    {
      "name": "gain",
      "dtype": "float32",
      "role": "static",
      "axes": [["any", 1]]
    }
  ],
  "outputs": [
    {
      "name": "audio_out",
      "dtype": "float32",
      "role": "streamed",
      "axes": [["batch", 1], ["channel", 16], ["time", 512]],
      "window": { "min": 512, "max": 512 }
    },
    {
      "name": "gain_out",
      "dtype": "float32",
      "role": "static",
      "axes": [["any", 1]]
    }
  ]
}
